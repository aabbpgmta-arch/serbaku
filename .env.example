# =============================================================================
# Toko Serba — Environment Variables
# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.
# =============================================================================

# ---- Supabase (client-visible, safe to ship in the browser bundle) ----------
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# ---- Supabase (server-only, used by createServerFn handlers / SSR) ----------
# Must mirror the VITE_* values above. Never prefix the service-role key with VITE_.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Service role key — bypasses RLS. Server-only. Never expose to the browser.
# Required if you use the admin client (`src/integrations/supabase/client.server.ts`).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
